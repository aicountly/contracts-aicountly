{
  "name": "aicountly/contracts-server-php",
  "description": "AICOUNTLY Contracts — PHP API (PostgreSQL). No runtime dependencies by design.",
  "type": "project",
  "license": "proprietary",
  "support": {
    "source": "https://github.com/aicountly/contracts-aicountly"
  },
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
