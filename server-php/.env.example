# ---------------------------------------------------------------------------
# Aicountly Contracts API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# The API refuses to serve when this disagrees with the hostname, because a
# sandbox .env copied onto the production host would tag production rows
# `sandbox` and no report would find them again.
APP_ENV=production

# --- Database (required) ---------------------------------------------------
# PostgreSQL. Create the database and role in cPanel, then run
#   cd <document root>/api && php database/migrate.php
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
# DB_SOCKET=/var/run/postgresql        # use instead of DB_HOST where cPanel uses a socket
# DB_SSLMODE=require                   # when PostgreSQL is on another host

# --- AICOUNTLY portal ------------------------------------------------------
# my.aicountly.com serves BOTH production and sandbox. sandbox.aicountly.com is
# a login redirect only; it does not serve seskey or validatesession.
# PORTAL_AUTH_BASE=https://my.aicountly.com

# --- Manage (company / branch / financial year) ----------------------------
# Derived from the hostname when unset: a *.gh.aicountly.com host resolves to
# manage.gh.aicountly.com, anything else to manage.aicountly.com.
# MANAGE_API_BASE=https://manage.aicountly.com

# --- Contacts (counterparty lookup) ----------------------------------------
# Same host derivation as Manage when unset.
# CONTACTS_API_BASE=https://contacts.aicountly.com

# --- Drive (document storage) ----------------------------------------------
# Aicountly Drive stores the bytes; Contracts stores the metadata and the
# document id. Leave DRIVE_API_BASE unset only for a deployment that has not
# provisioned Drive yet — see CONTRACTS_ALLOW_LOCAL_STORAGE below.
DRIVE_API_BASE=https://drive.aicountly.com

# Temporary fallback for a deployment where Drive is not yet available.
# Documents are written to CONTRACTS_LOCAL_STORAGE_PATH, which MUST be outside
# the document root. This is not an alternative home for contract documents —
# GET /api/health reports which adapter is active, and it should say `drive`.
CONTRACTS_ALLOW_LOCAL_STORAGE=false
# CONTRACTS_LOCAL_STORAGE_PATH=/home/<cpanel-user>/contracts-storage

# Upload limits, enforced server-side regardless of what the browser claims.
CONTRACTS_MAX_UPLOAD_MB=25

# --- Console (AI provider credentials) -------------------------------------
# Console (console.aicountly.org) is the system of record for LLM keys. Nothing
# is written to disk here: the resolved credential is held in process memory and
# in APCu where available. NEVER put a provider key in this file.
CONSOLE_API_URL=https://console.aicountly.org/api
CONSOLE_SERVICE_KEY=

# `auto` tries Console and falls back to a legacy .env key, logging each time.
# `console` requires Console and fails closed. Move to `console` once the key is
# loaded into Console → AI Connected Accounts and the logs are quiet.
AI_CREDENTIALS_SOURCE=auto

# Per-company AI throttles. These cost real money against the company's provider
# quota, which is why they are limited separately from everything else.
AI_RATE_LIMIT_PER_HOUR=120
AI_ASK_RATE_LIMIT_PER_HOUR=60

# --- Signature provider (optional) -----------------------------------------
# With none configured, Contracts still records an externally signed copy:
# upload the executed document and record the signatories and execution date.
# SIGNATURE_PROVIDER=
# SIGNATURE_WEBHOOK_SECRET=

# --- Notifications ---------------------------------------------------------
# In-app notifications always work. Email is off unless this is true AND a
# transport is configured — the product reports the channel honestly rather
# than pretending a message was sent.
CONTRACTS_EMAIL_ENABLED=false
# CONTRACTS_EMAIL_FROM=contracts@aicountly.com

# --- Automation ------------------------------------------------------------
# See docs/CRON_AND_JOBS.md for the cPanel cron lines.
# CONTRACTS_JOB_BATCH=25
# CONTRACTS_JOB_STALE_SECONDS=900

# --- Development only ------------------------------------------------------
# Comma-separated origins allowed to call this API cross-origin. Both deployed
# environments are same-origin with their app, so leave this EMPTY in
# production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Allows an integration to point at 127.0.0.1. Local development only — in
# production this would defeat the SSRF guard on outbound calls.
# ALLOW_LOOPBACK_INTEGRATIONS=false
