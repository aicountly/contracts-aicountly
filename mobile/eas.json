{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTRACTS_ENV": "sandbox"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CONTRACTS_ENV": "sandbox"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "android-preview": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_CONTRACTS_ENV": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "extends": "production",
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_CONTRACTS_ENV": "production"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_CONTRACTS_ENV": "production"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    },
    "production": {
      "ios": {},
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "production"
      }
    },
    "open-testing": {
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
