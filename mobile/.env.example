# Copy to .env for local development (expo start reads EXPO_PUBLIC_* vars automatically).

# "sandbox" -> contracts.gh.aicountly.com, "production" -> contracts.aicountly.com
EXPO_PUBLIC_CONTRACTS_ENV=sandbox

# Optional override — normally derived from EXPO_PUBLIC_CONTRACTS_ENV.
# EXPO_PUBLIC_API_ORIGIN=https://contracts.gh.aicountly.com

# Portal serving the login page for the SSO in-app-browser handoff (Google /
# LinkedIn / Microsoft). Derived from EXPO_PUBLIC_CONTRACTS_ENV: sandbox ->
# sandbox.aicountly.com, production -> my.aicountly.com. Override only to
# point at a test portal. Email/password, OTP and seskey calls always go to
# my.aicountly.com regardless — see src/config/env.ts.
# EXPO_PUBLIC_LOGIN_PORTAL_ORIGIN=https://sandbox.aicountly.com

# Where a user finishes deleting their AICOUNTLY account (App Review requires
# a direct link to the page that completes it, not a generic settings page).
# EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://my.aicountly.com/admin/home/data_privacy
