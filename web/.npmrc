# npm 10's peer-dependency resolver crashes ("Cannot read properties of null
# (reading 'edgesOut')") while walking vitest's optional browser-runner peers,
# which pull in @vitest/browser-playwright -> canvas. Nothing in this project
# uses the browser runner; the legacy resolver walks the same graph without the
# crash and produces the tree we actually want.
#
# Remove this once npm ships the arborist fix and `npm install` succeeds without it.
legacy-peer-deps=true
